{
  "id": "root",
  "type": "row",
  "background": "canvas",
  "divider": { "width": 1, "color": "border" },
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "terminal_padding": [14, 12],
  "children": [
    {
      "id": "sidebar", "type": "column", "size": { "px": 300 }, "min": 44, "max": 560, "background": "chrome", "resizable": false,
      "children": [
        { "id": "brand", "type": "block", "size": { "px": 46 }, "window_drag": true, "content": { "mod": "workspace-chrome" } },
        {
          "id": "tools", "type": "stack", "header": { "content": "tabs", "height": 30 }, "active": "agents",
          "children": [
            { "id": "agents", "title": "Agents", "type": "block", "content": { "mod": "agents" } },
            { "id": "spaces", "title": "Spaces", "type": "block", "content": { "mod": "spaces" } },
            { "id": "files", "title": "Files", "type": "block", "content": { "mod": "files" } },
            { "id": "changes", "title": "Changes", "type": "block", "content": { "mod": "changes" } }
          ]
        },
        { "id": "sidebar-footer", "type": "block", "size": { "px": 69 }, "content": { "mod": "workspace-chrome", "props": { "footer": true } } }
      ]
    },
    {
      "id": "work", "type": "column", "resizable": false,
      "children": [
        { "id": "tabs", "type": "block", "size": { "px": 42 }, "window_drag": true, "content": { "mod": "tabs" } },
        {
          "id": "main", "type": "block", "padding": 8,
          "content": { "tab": "active", "pane": {
            "header": { "content": { "mod": "pane" }, "reveal": "always", "height": 30, "position": "top" },
            "background": "background", "border": { "width": 1, "color": "border" }, "focus": { "width": 1, "color": "accent" },
            "radius": 10, "gap": 8, "lone": true } }
        },
        { "id": "status", "type": "block", "size": { "px": 28 }, "content": { "mod": "workspace-status" } }
      ]
    }
  ]
}
